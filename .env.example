# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- PostgreSQL (used by the db container and inside DATABASE_URL) ----------
POSTGRES_DB=dailyhit
POSTGRES_USER=dailyhit
# Change it. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me
# Host port for the dev database (bound to 127.0.0.1 only). Not exposed in prod.
POSTGRES_HOST_PORT=5432

# --- Django -----------------------------------------------------------------
# Containers reach the database by service name "db", not localhost.
DATABASE_URL=postgres://dailyhit:change-me@db:5432/dailyhit
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# true only for local development.
DJANGO_DEBUG=true
# Comma-separated hostnames. Prod: your domain, e.g. dailyhit.example
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme. Prod: https://your-domain
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
# Admin path, relative, ending with "/". In prod use something non-obvious.
DJANGO_ADMIN_URL=admin/
# Run migrations on container start (1/0).
DJANGO_MIGRATE=1
# Collect static files on container start (prod: 1).
DJANGO_COLLECTSTATIC=0
# Prod security (defaults follow DJANGO_DEBUG): HTTPS redirect, secure cookies, HSTS.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_COOKIES=true
# DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
# Host port for Django (change if 8000 is taken on your machine).
BACKEND_HOST_PORT=8000

# --- Game rules (optional; defaults shown) ---------------------------------
# GAME_MAX_ATTEMPTS=10
# Fact hints unlock after these attempt numbers, comma-separated.
# GAME_HINT_ATTEMPTS=5,8
# GAME_YEAR_YELLOW_RANGE=5

# --- Frontend (dev) ---------------------------------------------------------
# Set true if Vite does not pick up file changes inside Docker.
VITE_USE_POLLING=false
# Host port for the Vite dev server.
FRONTEND_HOST_PORT=5173
